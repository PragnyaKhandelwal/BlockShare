# Copy to .env (docker compose) or set as environment variables on your host.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://your-domain.example
ADMIN_PASSWORD=choose-a-strong-admin-password
DEMO_SEED=1
DEMO_PASSWORD=blockshare123

# Storage cluster
BLOCKSHARE_NODES=node-a@127.0.0.1:9101/10101/9301,node-b@127.0.0.1:9102/10102/9302,node-c@127.0.0.1:9103/10103/9303
CLUSTER_KEY=change-me-cluster-secret
CHUNK_SIZE=1048576
REPLICATION_FACTOR=2
MAX_UPLOAD_MB=100

# Blockchain (local dev chain by default; any EVM JSON-RPC works, e.g. Sepolia)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# BLOCKCHAIN_OPERATOR_KEY=0x...   (funded account that deploys contracts and funds user wallets)
BLOCKCHAIN_DEFAULT_ON=false
# BLOCKCHAIN_EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/
